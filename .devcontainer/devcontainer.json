{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": ["docker-compose.yaml"],
  "workspaceFolder": "/workspace",
  "service": "protect",
  "overrideCommand": false,
	"customizations": {
		"vscode": {
			"extensions": [
				"halon.vscode-halon",
				"halon.hsl-syntax",
